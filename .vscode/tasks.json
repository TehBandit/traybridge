{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "${workspaceFolder}/.tools/dotnet/dotnet.exe",
            "type": "process",
            "options": {
                "env": {
                    "DOTNET_CLI_HOME": "${workspaceFolder}/.tools/dotnet-home",
                    "NUGET_PACKAGES": "${workspaceFolder}/.tools/packages"
                }
            },
            "args": [
                "build",
                "${workspaceFolder}/TrayBridge/TrayBridge.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "${workspaceFolder}/.tools/dotnet/dotnet.exe",
            "type": "process",
            "options": {
                "env": {
                    "DOTNET_CLI_HOME": "${workspaceFolder}/.tools/dotnet-home",
                    "NUGET_PACKAGES": "${workspaceFolder}/.tools/packages"
                }
            },
            "args": [
                "publish",
                "${workspaceFolder}/TrayBridge/TrayBridge.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "${workspaceFolder}/.tools/dotnet/dotnet.exe",
            "type": "process",
            "options": {
                "env": {
                    "DOTNET_ROOT": "${workspaceFolder}/.tools/dotnet",
                    "DOTNET_ROOT_X64": "${workspaceFolder}/.tools/dotnet",
                    "DOTNET_CLI_HOME": "${workspaceFolder}/.tools/dotnet-home",
                    "NUGET_PACKAGES": "${workspaceFolder}/.tools/packages"
                }
            },
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/TrayBridge/TrayBridge.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
